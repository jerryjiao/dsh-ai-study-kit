---
import Layout from '../layouts/Layout.astro';
import SiteNav from '../components/SiteNav.astro';
import SiteChangelog from '../components/SiteChangelog.astro';
import SiteFooter from '../components/SiteFooter.astro';
import { getSite } from '../site-data';

const s = getSite('zh');
---

<Layout lang="zh" title={s.changelog.title} description={s.changelog.description}>
  <SiteNav lang="zh" />
  <SiteChangelog lang="zh" />
  <SiteFooter lang="zh" />
</Layout>
