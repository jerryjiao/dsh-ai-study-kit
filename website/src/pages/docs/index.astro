    padding-bottom: 28px;
    border-bottom: 2px solid var(--line);
    margin-bottom: 8px;
  }

  .docs-head h1 {
    font-size: clamp(1.9rem, 4vw, 2.5rem);
    margin-bottom: 14px;
  }

  .docs-lead {
    color: var(--fg-muted);
    font-size: 1.05rem;
    max-width: 68ch;
  }

  .prose section {
    padding-top: 32px;
  }

  .prose h2 {
    font-size: 1.45rem;
    margin-bottom: 14px;
    scroll-margin-top: 24px;
    padding-bottom: 8px;
