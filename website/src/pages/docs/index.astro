    gap: 6px;
    padding-top: 12px;
    border-top: 2px solid var(--line);
    color: var(--fg-muted);
    font-size: 0.88rem;
    font-weight: 600;
    text-decoration: none;
  }

  .docs-back svg {
    transform: rotate(180deg);
  }

