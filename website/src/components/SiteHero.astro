---
import Icon from './Icon.astro';
import {
  INSTALL_CMD,
  LICENSE,
  VERSION,
  getSite,
  langPath,
  type Lang,
} from '../site-data';

interface Props {
  lang?: Lang;
}

const { lang = 'zh' } = Astro.props;
const s = getSite(lang);
const base = import.meta.env.BASE_URL;
const docsHref = langPath(lang, base, 'docs/');
---

<section class="hero" id="top">
  <div class="container hero-grid">
    <div class="hero-copy">
      <p class="kicker">{s.hero.kicker}</p>
      <h1 class="hero-title">
        {s.hero.titleBefore}<span class="hero-accent">{s.hero.titleAccent}</span><br />{s.hero.titleAfter}
      </h1>
      <p class="hero-sub">{s.hero.sub}</p>

      <div class="install" id="install">
        <div class="codeblock">
          <div class="codeblock-bar">
            <span class="codeblock-lang">
              <Icon name="terminal" size={16} /> {s.hero.terminal}
            </span>
            <button
              class="copy-btn"
              type="button"
              data-copy={INSTALL_CMD}
              aria-label={s.hero.copyCmd}
            >
              <Icon name="copy" size={16} class="icon-copy" />
              <Icon name="check" size={16} class="icon-check" />
              <span class="copy-status visually-hidden" aria-live="polite"
              ></span>
            </button>
          </div>
          <div class="codeblock-body">
            <div class="cmd"><span class="prompt">$</span> {INSTALL_CMD}</div>
          </div>
        </div>
        <p class="note">{s.meta.prereq}</p>
      </div>

      <div class="hero-links">
        <a class="btn btn-primary" href="#quickstart">
          {s.hero.ctaPrimary} <Icon name="arrow-right" size={16} />
        </a>
        <a class="btn btn-ghost" href={docsHref}>
          <Icon name="book-open" size={16} /> {s.hero.ctaDocs}
        </a>
      </div>

      <p class="hero-meta">
        v{VERSION} · {LICENSE} {s.meta.licenseWord} · {s.meta.telemetry} · {s.meta.noServer}
      </p>
    </div>

    <aside class="hero-panel" aria-label={s.hero.panelAria}>
      <p class="panel-label">{s.hero.panelLabel}</p>

      <div class="panel-group">
        <p class="panel-caption">{s.hero.panelCaptionSidebar}</p>
        <ul class="chip-list">
          {s.consolePages.map((page) => (
            <li class="chip">
              <Icon name={page.icon} size={16} /> {page.name}
            </li>
          ))}
        </ul>
      </div>

      <div class="panel-group">
        <p class="panel-caption">{s.hero.panelCaptionSession}</p>
        <ul class="chip-list chip-list-mono">
          {s.skills.map((skill) => (
            <li class="chip chip-mono">{skill.cmd}</li>
          ))}
        </ul>
      </div>

      <p class="panel-foot">{s.hero.panelFoot}</p>
    </aside>
  </div>
</section>

<style>
  .hero {
    padding-block: 72px 64px;
    background: var(--bg);
  }

  .hero-grid {
    display: grid;
    grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
    gap: 56px;
    align-items: start;
  }

  .hero-title {
    font-size: clamp(2.6rem, 6vw, 4rem);
    line-height: 1.12;
    letter-spacing: -0.025em;
    margin-bottom: 20px;
  }

  .hero-accent {
    color: var(--green-deep);
  }

  @media (prefers-color-scheme: dark) {
    .hero-accent {
      color: var(--green);
    }
  }

  .hero-sub {
    max-width: 34ch;
    margin-bottom: 28px;
    color: var(--fg-muted);
    font-size: 1.08rem;
    line-height: 1.7;
  }

  .install {
    max-width: 520px;
    display: grid;
    gap: 10px;
  }

  .hero-links {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 28px;
  }

  .hero-meta {
    margin-top: 28px;
    color: var(--fg-faint);
    font-family: var(--font-mono);
    font-size: 0.78rem;
  }

  .hero-panel {
    border: 2px solid var(--line);
    border-radius: var(--radius-lg);
    background: var(--surface);
    box-shadow: var(--shadow-card);
    padding: 24px;
  }

  .panel-label {
    color: var(--fg-faint);
    font-family: var(--font-mono);
    font-size: 0.75rem;
    letter-spacing: 0.06em;
  }

  .panel-group {
    margin-top: 18px;
  }

  .panel-caption {
    margin-bottom: 10px;
    color: var(--fg-muted);
    font-size: 0.85rem;
    font-weight: 700;
  }

  .chip-list {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .chip {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 6px 12px;
    border: 2px solid var(--line);
    border-radius: 999px;
    background: var(--surface-2);
    font-size: 0.85rem;
    font-weight: 600;
    line-height: 1.3;
  }

  .chip-mono {
    border-color: var(--line);
    background: var(--surface);
    color: var(--fg-muted);
    font-family: var(--font-mono);
    font-size: 0.78rem;
  }

  .panel-foot {
    margin-top: 22px;
    padding-top: 16px;
    border-top: 2px solid var(--line);
    color: var(--fg-muted);
    font-size: 0.85rem;
  }

  @media (max-width: 899px) {
    .hero {
      padding-block: 40px 44px;
    }

    .hero-grid {
      grid-template-columns: 1fr;
      gap: 36px;
    }

    .hero-title {
      font-size: clamp(2.3rem, 9vw, 3rem);
    }
  }
</style>
