---
import Icon from './Icon.astro';
import { getSite, type Lang } from '../site-data';

interface Props {
  code: string;
  label?: string;
  copy?: boolean;
  lang?: Lang;
}

const { code, label = 'bash', copy = true, lang = 'zh' } = Astro.props;
const s = getSite(lang);
---

<div class="codeblock">
  <div class="codeblock-bar">
    <span class="codeblock-lang">
      <Icon name="terminal" size={16} /> {label}
    </span>
    {copy && (
      <button
        class="copy-btn"
        type="button"
        data-copy={code}
        aria-label={s.codeblock.copy}
      >
        <Icon name="copy" size={16} class="icon-copy" />
        <Icon name="check" size={16} class="icon-check" />
        <span class="copy-status visually-hidden" aria-live="polite"></span>
      </button>
    )}
  </div>
  <div class="codeblock-body">
    <pre><code>{code}</code></pre>
  </div>
</div>
