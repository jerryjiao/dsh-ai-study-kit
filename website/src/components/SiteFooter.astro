---
import GithubMark from './GithubMark.astro';
import { LICENSE, PRODUCT, REPO_URL, VERSION } from '../site-data';

const base = import.meta.env.BASE_URL;
const year = new Date().getFullYear();
---

<footer class="footer">
  <div class="container footer-inner">
    <div class="footer-brand">
      <a class="footer-name" href={base}>
        <img src={`${base}mark-1024.png`} alt="" width="28" height="28" />
        {PRODUCT}
      </a>
      <p class="footer-note">把学习教练装进 DeepSeek Harness。</p>
    </div>

    <nav class="footer-links" aria-label="页脚">
      <a href={REPO_URL}>
        <GithubMark size={16} /> GitHub 仓库
      </a>
      <a href={`${base}docs/`}>文档</a>
      <a href={`${base}changelog/`}>更新日志</a>
      <a href={`${REPO_URL}/blob/main/LICENSE`}>MIT 许可证</a>
    </nav>

    <div class="footer-meta">
      <span>v{VERSION}</span>
      <span>{LICENSE}</span>
      <span>Made for DeepSeek Harness</span>
      <span>© {year}</span>
    </div>
  </div>
</footer>

<style>
  .footer {
    margin-top: 0;
    padding-block: 40px 32px;
    border-top: 2px solid var(--line);
    background: var(--surface);
  }

  .footer-inner {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: 20px 32px;
    align-items: start;
  }

  .footer-name {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-weight: 800;
    text-decoration: none;
  }

  .footer-name img {
    width: 28px;
    height: 28px;
    border: 2px solid var(--line);
    border-radius: 8px;
    background: var(--surface-2);
  }

  .footer-note {
    margin-top: 6px;
    color: var(--fg-muted);
    font-size: 0.88rem;
  }

  .footer-links {
    display: flex;
    flex-wrap: wrap;
    gap: 18px;
    font-size: 0.88rem;
    font-weight: 600;
  }

  .footer-links a {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    color: var(--fg-muted);
    text-decoration: none;
  }

  .footer-links a:hover {
    color: var(--fg);
    text-decoration: underline;
    text-decoration-thickness: 2px;
    text-underline-offset: 3px;
  }

  .footer-meta {
    grid-column: 1 / -1;
    display: flex;
    flex-wrap: wrap;
    gap: 8px 18px;
    padding-top: 18px;
    border-top: 2px solid var(--line);
    color: var(--fg-faint);
    font-family: var(--font-mono);
    font-size: 0.76rem;
  }

  @media (max-width: 899px) {
    .footer-inner {
      grid-template-columns: 1fr;
    }
  }
</style>
