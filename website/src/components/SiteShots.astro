---
import { getSite, shotPath, type Lang } from '../site-data';

interface Props {
  lang?: Lang;
}

const { lang = 'zh' } = Astro.props;
const s = getSite(lang);
const base = import.meta.env.BASE_URL;
---

<section class="section shots" id="shots">
  <div class="container">
    <div class="section-head">
      <p class="kicker">{s.shots.kicker}</p>
      <h2 class="section-title">{s.shots.title}</h2>
      <p class="section-sub">{s.shots.sub}</p>
    </div>

    <div class="shot-grid">
      {s.shots.items.map((shot, i) => (
        <figure class:list={['shot', { 'shot-wide': i === 0 }]}>
          <div class="shot-frame">
            <img
              src={shotPath(lang, base, shot.file)}
              alt={shot.alt}
              loading="lazy"
              decoding="async"
              width="1440"
              height="900"
            />
          </div>
          <figcaption>
            <strong>{shot.title}</strong>
            <span>{shot.caption}</span>
          </figcaption>
        </figure>
      ))}
    </div>
  </div>
</section>

<style>
  .shot-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 24px;
  }

  .shot-wide {
    grid-column: 1 / -1;
  }

  @media (max-width: 899px) {
    .shot-grid {
      grid-template-columns: 1fr;
      gap: 20px;
    }
  }
</style>
