---
import { SHOTS } from '../site-data';

const base = import.meta.env.BASE_URL;
---

<section class="section shots" id="shots">
  <div class="container">
    <div class="section-head">
      <p class="kicker">截图</p>
      <h2 class="section-title">学习台长什么样</h2>
      <p class="section-sub">
        四个页面，加一张深色模式。截图都来自虚构的示例学习项目，不含任何真实用户数据。
      </p>
    </div>

    <div class="shot-grid">
      {SHOTS.map((shot, i) => (
        <figure class:list={['shot', { 'shot-wide': i === 0 }]}>
          <div class="shot-frame">
            <img
              src={`${base}screenshots/${shot.file}.png`}
              alt={shot.alt}
              loading="lazy"
              decoding="async"
              width="1440"
              height="900"
            />
          </div>
          <figcaption>
            <strong>{shot.title}</strong>
            <span>{shot.caption}</span>
          </figcaption>
        </figure>
      ))}
    </div>
  </div>
</section>

<style>
  .shot-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 24px;
  }

  .shot-wide {
    grid-column: 1 / -1;
  }

  @media (max-width: 899px) {
    .shot-grid {
      grid-template-columns: 1fr;
      gap: 20px;
    }
  }
</style>
