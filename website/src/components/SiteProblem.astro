---
import Icon from './Icon.astro';
import { getSite, type Lang } from '../site-data';

interface Props {
  lang?: Lang;
}

const { lang = 'zh' } = Astro.props;
const s = getSite(lang);
---

<section class="section problem" id="why">
  <div class="container">
    <div class="section-head">
      <p class="kicker">{s.problem.kicker}</p>
      <h2 class="section-title">{s.problem.title}</h2>
      <p class="section-sub">{s.problem.sub}</p>
    </div>

    <div class="grid-3">
      {s.problem.items.map((item, i) => (
        <article class="problem-card">
          <div class="problem-top">
            <span class="icon-badge icon-badge-green">
              <Icon name={item.icon} size={20} />
            </span>
            <span class="problem-num">0{i + 1}</span>
          </div>
          <h3 class="card-title">{item.title}</h3>
          <p class="card-body">{item.body}</p>
        </article>
      ))}
    </div>
  </div>
</section>

<style>
  .problem-card {
    display: flex;
    flex-direction: column;
    gap: 0;
    padding: 24px;
    border: 2px solid var(--line);
    border-radius: var(--radius);
    background: var(--surface);
    box-shadow: var(--shadow-card);
  }

  .problem-top {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    margin-bottom: 18px;
  }

  .problem-top .icon-badge {
    margin-bottom: 0;
  }

  .problem-num {
    color: var(--fg-faint);
    font-family: var(--font-mono);
    font-size: 0.85rem;
    font-weight: 700;
  }
</style>
