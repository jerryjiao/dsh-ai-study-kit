---
import Icon from './Icon.astro';
import { getSite, type Lang } from '../site-data';

interface Props {
  lang?: Lang;
}

const { lang = 'zh' } = Astro.props;
const s = getSite(lang);
---

<section class="section architecture" id="architecture">
  <div class="container">
    <div class="section-head">
      <p class="kicker">{s.architecture.kicker}</p>
      <h2 class="section-title">{s.architecture.title}</h2>
      <p class="section-sub">{s.architecture.sub}</p>
    </div>

    <div class="arch" role="img" aria-label={s.architecture.aria}>
      {s.architecture.items.map((item) =>
        item.kind === 'box' ? (
          <div class:list={['arch-box', `arch-box-${item.tone}`]}>
            <span class="arch-kicker">{item.kicker}</span>
            <strong>{item.title}</strong>
            <span class="arch-sub">{item.sub}</span>
          </div>
        ) : (
          <div class="arch-link">
            <span>⇄</span>
            <small set:html={item.lines.join('<br />')} />
          </div>
        ),
      )}
    </div>

    <details class="arch-more">
      <summary>
        <span class="faq-chev"><Icon name="chevron-down" size={18} /></span>
        {s.architecture.moreSummary}
      </summary>
      <div class="arch-more-body">
        {s.architecture.details.map((detail) => (
          <Fragment>
            <h3>{detail.title}</h3>
            <p>{detail.body}</p>
          </Fragment>
        ))}
      </div>
    </details>
  </div>
</section>

<style>
  .arch {
    display: flex;
    align-items: stretch;
    gap: 6px;
    padding: 22px;
    border: 2px solid var(--line);
    border-radius: var(--radius-lg);
    background: var(--surface);
    box-shadow: var(--shadow-card);
  }

  .arch-box {
    flex: 1 1 0;
    display: flex;
    flex-direction: column;
    gap: 4px;
    min-width: 0;
    padding: 14px;
    border: 2px solid var(--line);
    border-radius: var(--radius-sm);
    background: var(--surface-2);
  }

  .arch-box-blue {
    border-color: color-mix(in srgb, var(--blue) 45%, var(--line));
    background: var(--blue-tint);
  }

  .arch-box-green {
    border-color: color-mix(in srgb, var(--green) 45%, var(--line));
    background: var(--green-tint);
  }

  .arch-box-gold {
    border-color: color-mix(in srgb, var(--gold) 45%, var(--line));
    background: var(--gold-tint);
  }

  .arch-box-plain {
    border-style: dashed;
    border-color: var(--line-strong);
  }

  .arch-kicker {
    color: var(--fg-faint);
    font-family: var(--font-mono);
    font-size: 0.7rem;
    letter-spacing: 0.05em;
  }

  .arch-box strong {
    font-size: 0.95rem;
    line-height: 1.3;
  }

  .arch-sub {
    color: var(--fg-muted);
    font-family: var(--font-mono);
    font-size: 0.72rem;
    line-height: 1.5;
    overflow-wrap: anywhere;
  }

  .arch-link {
    flex: 0 0 auto;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 2px;
    min-width: 52px;
    color: var(--fg-faint);
    text-align: center;
  }

  .arch-link span {
    font-size: 1.2rem;
    line-height: 1;
  }

  .arch-link small {
    font-family: var(--font-mono);
    font-size: 0.66rem;
    line-height: 1.3;
  }

  .arch-more {
    margin-top: 20px;
    border: 2px solid var(--line);
    border-radius: var(--radius);
    background: var(--surface);
    overflow: hidden;
  }

  .arch-more summary {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 16px 20px;
    cursor: pointer;
    font-weight: 700;
    font-size: 0.95rem;
  }

  .arch-more summary::-webkit-details-marker {
    display: none;
  }

  .arch-more[open] summary .faq-chev {
    transform: rotate(180deg);
  }

  .arch-more-body {
    padding: 0 20px 20px;
  }

  .arch-more-body h3 {
    margin-top: 16px;
    margin-bottom: 6px;
    font-size: 0.98rem;
  }

  .arch-more-body p {
    color: var(--fg-muted);
    font-size: 0.92rem;
    max-width: 74ch;
  }

  @media (max-width: 899px) {
    .arch {
      flex-direction: column;
      gap: 4px;
      padding: 16px;
    }

    .arch-link {
      min-width: 0;
      flex-direction: row;
      gap: 8px;
      padding-block: 2px;
    }

    .arch-link span {
      transform: rotate(90deg);
    }

    .arch-link small br {
      display: none;
    }
  }
</style>
