---
import GithubMark from './GithubMark.astro';
import {
  PRODUCT,
  REPO_URL,
  alternatePath,
  getSite,
  langPath,
  type Lang,
} from '../site-data';

interface Props {
  lang?: Lang;
}

const { lang = 'zh' } = Astro.props;
const s = getSite(lang);
const base = import.meta.env.BASE_URL;
const homeHref = langPath(lang, base);
const other = lang === 'en' ? 'zh' : 'en';
// 锚点固定在首页；在其他页面点击会自动回到首页对应区块。窄屏折成两行，不用汉堡菜单。
---

<header class="nav">
  <div class="container nav-inner">
    <a class="brand" href={homeHref} aria-label={`${PRODUCT}${s.nav.ariaHome}`}>
      <img
        class="brand-mark"
        src={`${base}mark-1024.png`}
        alt=""
        width="36"
        height="36"
      />
      <span class="brand-name">{PRODUCT}</span>
    </a>

    <nav class="nav-links" aria-label={s.nav.ariaSections}>
      {s.nav.links.map((link) => (
        <a href={`${homeHref}${link.href}`}>{link.label}</a>
      ))}
    </nav>

    <div class="nav-actions">
      <a
        class="nav-lang"
        href={alternatePath(lang, Astro.url.pathname, base)}
        aria-label={s.nav.langLabel}
        title={s.nav.langLabel}
        hreflang={other}
        lang={other === 'zh' ? 'zh-CN' : 'en'}
      >
        {s.nav.langText}
      </a>
      <a
        class="nav-github"
        href={REPO_URL}
        aria-label={s.nav.ariaRepo}
        title={s.nav.repoTitle}
      >
        <GithubMark size={20} />
      </a>
      <a class="btn btn-primary btn-sm" href={`${homeHref}#install`}>
        {s.nav.install}
      </a>
    </div>
  </div>
</header>

<style>
  .nav {
    background: var(--surface);
    border-bottom: 2px solid var(--line);
  }

  .nav-inner {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 12px 24px;
    padding-block: 12px;
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    text-decoration: none;
    font-weight: 800;
    font-size: 1.02rem;
    letter-spacing: -0.01em;
  }

  .brand-mark {
    width: 36px;
    height: 36px;
    border: 2px solid var(--line);
    border-radius: 10px;
    background: var(--surface-2);
  }

  .nav-links {
    display: flex;
    margin-inline: auto;
    gap: 26px;
  }

  .nav-links a {
    color: var(--fg-muted);
    font-size: 0.94rem;
    font-weight: 600;
    text-decoration: none;
    transition: color 0.12s var(--ease);
  }

  .nav-links a:hover {
    color: var(--fg);
    text-decoration: underline;
    text-decoration-thickness: 2px;
    text-underline-offset: 4px;
  }

  .nav-actions {
    display: inline-flex;
    align-items: center;
    gap: 12px;
  }

  .nav-lang {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 44px;
    height: 40px;
    padding-inline: 10px;
    border: 2px solid var(--line);
    border-radius: 12px;
    background: var(--surface);
    color: var(--fg-muted);
    font-size: 0.86rem;
    font-weight: 700;
    text-decoration: none;
    transition: color 0.12s var(--ease), border-color 0.12s var(--ease);
  }

  .nav-lang:hover {
    color: var(--fg);
    border-color: var(--line-strong);
  }

  .nav-github {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 40px;
    height: 40px;
    border: 2px solid var(--line);
    border-radius: 12px;
    background: var(--surface);
    color: var(--fg-muted);
    transition: color 0.12s var(--ease), border-color 0.12s var(--ease);
  }

  .nav-github:hover {
    color: var(--fg);
    border-color: var(--line-strong);
  }

  @media (max-width: 899px) {
    .nav-inner {
      padding-block: 10px;
    }

    .nav-actions {
      margin-left: auto;
    }

    .nav-links {
      order: 3;
      width: 100%;
      margin-inline: 0;
      gap: 20px;
      padding-top: 10px;
      border-top: 2px solid var(--line);
      overflow-x: auto;
      white-space: nowrap;
      scrollbar-width: none;
    }

    .nav-links::-webkit-scrollbar {
      display: none;
    }

    .brand-name {
      font-size: 0.98rem;
    }
  }
</style>
